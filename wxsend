#!/bin/zsh
# Fixed-route WeChat send through iPhone Mirroring: no model in the loop, no typing on the phone.
# Every phone step is a deterministic mirroir replay (routes/*.yaml); this script only branches and pastes.
# Usage: ./wxsend "<contact name as WeChat shows it>" "<message>"
# Needs: iPhone Mirroring connected, WeChat in the Dock, mirroir-mcp (MIRROIR overrides the command).
cd "${0:A:h}"; zmodload zsh/datetime
[[ $# -eq 2 && -n "$1" && -n "$2" ]] || { echo 'usage: ./wxsend "<contact>" "<message>"' >&2; exit 2; }
export PATH=$HOME/.local/bin:$PATH
M=(${=MIRROIR:-$(command -v mirroir-mcp || echo npx -y mirroir-mcp@0.50.3)})   # brew install jfarcand/tap/mirroir-mcp skips the npx start-up
mkdir -p chat-log
step() {  # step <route> : replay one route, log its output, return its verdict
  print -r -- "== $(date '+%F %T') $1" >> chat-log/route.log
  (cd routes && CONTACT="$CONTACT" MSG_CHECK="$MSG_CHECK" $M test --confirm-destructive --timeout 6 "$1.yaml") >> chat-log/route.log 2>&1
}
CONTACT="$1"; MSG_CHECK="${2[1,12]}"   # ponytail: OCR-check the first 12 chars; a contact shown only as emoji cannot be OCR-checked
t0=$EPOCHREALTIME
step wechat-home || step wechat-back || { echo "not on the WeChat chat list; nothing sent" >&2; exit 1; }
./outbox "search" "$1" >/dev/null
step wechat-search || { echo "could not open the chat with $1; nothing sent" >&2; exit 1; }
./outbox "$1" "$2" >/dev/null
step wechat-paste-send || { echo "message not confirmed in the input; NOT sent (check the phone)" >&2; exit 1; }
printf 'sent to %s in %.1fs\n' "$1" $(( EPOCHREALTIME - t0 ))
